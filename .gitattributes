# The benchmark pins its corpus, frozen labels, and repeat subset by SHA-256,
# and every recorded run identity carries those hashes. A checkout that
# rewrote line endings would change the hashes without changing the content,
# so these files are byte-stable on every platform.
*.jsonl        text eol=lf
*.json         text eol=lf
*.py           text eol=lf
*.md           text eol=lf
*.toml         text eol=lf
*.sh           text eol=lf
*.spec         text eol=lf

# Written by Python's csv module, whose dialect terminates rows with CRLF.
# The run manifests record the SHA-256 of these files as written.
*.csv          -text

*.png          binary
*.pdf          binary
*.ico          binary
*.icns         binary
